# Application Configuration
APP_NAME="Talk to Your Data - Text-to-SQL Analytics Assistant"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Database Configuration
# PostgreSQL (Production Target): postgresql://user:password@localhost:5432/analytics_db
# SQLite (Zero-Config Fallback Target): sqlite:///./ecommerce.db
DATABASE_URL="sqlite:///./ecommerce.db"
DB_ECHO=false

# LLM Provider Configuration
# Supported providers: gemini, openai, mock
LLM_PROVIDER="gemini"

# Google Gemini Configuration
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# OpenAI Configuration (Optional)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Guardrail & Safety Limits
MAX_QUERY_ROW_LIMIT=100
DEFAULT_QUERY_ROW_LIMIT=50
MAX_SELF_CORRECTION_RETRIES=3
STATEMENT_TIMEOUT_SECONDS=10.0
